---
import { copy, type Lang } from "../data/content";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
---
<header class="nav">
  <div class="wrap">
    <a class="wordmark" href="#top" aria-label={t.name}><span class="mono-mark" aria-hidden="true">AO</span><span class="wm-text">{t.name}</span></a>
    <div class="nav__right">
      <nav class="nav__links" aria-label="Sections">
        <a class="link" href="#work">{t.nav.work}</a>
        <a class="link" href="#apps">{t.nav.apps}</a>
        <a class="link" href="#about">{t.nav.about}</a>
        <a class="link" href="#contact">{t.nav.contact}</a>
        <span class="nav__rule" aria-hidden="true"></span>
      </nav>
      <a class="btn btn--primary nav__cta" href="#contact">{t.nav.cta}</a>
      <nav class="lang" aria-label={t.langLabel}>
        <a href="/" lang="en" hreflang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a>
        <a href="/es/" lang="es" hreflang="es" aria-current={lang === "es" ? "page" : undefined}>ES</a>
      </nav>
      <div class="theme-switch" id="themeSwitch" role="group" aria-label={t.theme.group}>
        <span class="thumb" aria-hidden="true"></span>
        <button type="button" data-mode="auto" aria-pressed="true" aria-label={t.theme.auto} title={t.theme.auto}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 4v16"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/></svg></button>
        <button type="button" data-mode="light" aria-pressed="false" aria-label={t.theme.light} title={t.theme.light}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg></button>
        <button type="button" data-mode="dark" aria-pressed="false" aria-label={t.theme.dark} title={t.theme.dark}><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
      </div>
    </div>
  </div>
</header>
